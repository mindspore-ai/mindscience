FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Estimated from inlet velocity and turbulence intensity ~5%
internalField   uniform 0.0015;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.0015;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            kqRWallFunction;
        value           uniform 0.0015;
    }
    frontAndBack
    {
        type            empty;
    }
}

