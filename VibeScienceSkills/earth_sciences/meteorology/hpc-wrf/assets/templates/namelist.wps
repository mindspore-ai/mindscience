&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2024-01-01_00:00:00', '2024-01-01_00:00:00',
 end_date   = '2024-01-03_00:00:00', '2024-01-03_00:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
 opt_output_from_geogrid_path = './',
 debug_level = 0,
/

&geogrid
 parent_id         =  1,   1,
 parent_grid_ratio =  1,   3,
 i_parent_start    =  1,  30,
 j_parent_start    =  1,  30,
 e_we              = 151, 151,
 e_sn              = 151, 151,
 geog_data_res     = 'default','default',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   =  35.0,
 ref_lon   = 120.0,
 truelat1  =  30.0,
 truelat2  =  60.0,
 stand_lon = 120.0,
 geog_data_path = '/path/to/WPS_GEOG/',
 opt_geogrid_tbl_path = './geogrid/',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
 opt_output_from_metgrid_path = './',
 opt_metgrid_tbl_path = './metgrid/',
/
