# CST Waveguide Port Template
# This is a VBA macro template for waveguide port setup

# Project: Waveguide Port Excitation
# Purpose: Template for setting up waveguide ports in CST

# === Parameters ===
# freq_center = 10e9        # Center frequency (Hz)
# waveguide_width = 22.86e-3 # WR-90 width (m)
# waveguide_height = 10.16e-3 # WR-90 height (m)

# === VBA Commands ===
# Create new project
NewProject

# Set units
SetUnit "mm"

# Define frequency range
SetFrequencyRange 8e9, 12e9

# Create waveguide geometry
Brick "waveguide", "waveguide_width", "waveguide_height", "50"

# Set material (vacuum/air)
Material "waveguide", "Vacuum"

# Add waveguide port at input
Port "Port1", "waveguide", "zmin"
PortType "Waveguide"
PortModes 1  # TE10 mode

# Add waveguide port at output
Port "Port2", "waveguide", "zmax"
PortType "Waveguide"
PortModes 1

# Set boundary conditions
Boundary "xmin", "Electric"
Boundary "xmax", "Electric"
Boundary "ymin", "Electric"
Boundary "ymax", "Electric"

# Set solver
Solver "Transient"
SolverAccuracy -50  # -50 dB

# Mesh settings
MeshCellsPerWavelength 15

# === Notes ===
# 1. Adjust waveguide dimensions for your frequency band
# 2. Add more modes if higher-order modes are needed
# 3. Enable adaptive mesh for better accuracy
